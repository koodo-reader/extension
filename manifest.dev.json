{
  "action": {
    "default_icon": "public/dev-icon-32.png",
    "default_popup": "src/pages/popup/index.html"
  },
  "icons": {
    "128": "public/dev-icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dev-icon-128.png", "dev-icon-32.png"],
      "matches": []
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.koodoreader.com/*",
      "https://*.koodoreader.cn/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.koodoreader.com/*",
        "https://*.koodoreader.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["src/pages/content/main-world.ts"]
    },
    {
      "matches": [
        "https://*.koodoreader.com/*",
        "https://*.koodoreader.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "run_at": "document_start",
      "js": ["src/pages/content/index.tsx"],
      "css": []
    }
  ]
}
